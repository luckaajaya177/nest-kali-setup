# THE FORGED NEST — Environment
# ============================================================
NEST_BASE=$HOME/.nest
NEST_MODE=4070-apex
NEST_VERSION=9.0.0
NEST_UNLIMITED=true
NEST_LAYER=14
NEST_QUANTUM_DRIFT=true
NEST_ADVERSARIAL_REWRITE=true
NEST_MODEL_FINGERPRINT=true

# LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_MAX_TOKENS=8192
LLM_MAX_TURNS=0
LLM_MAX_STEPS=0

# API Keys (uncomment and set your keys)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# Shadow Toolkit
SHADOW_WS_PORT=8766
SHADOW_CF_BYPASS=true

# Opencode
OPENCODE_CONFIG=$NEST_BASE/config/opencode.json
